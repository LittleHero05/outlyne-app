# Supabase — get these from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-only key for API routes (never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile site key (public). Leave empty locally to skip the CAPTCHA.
# Test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
