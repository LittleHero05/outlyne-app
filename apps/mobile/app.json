{
  "expo": {
    "name": "Outlyne",
    "slug": "outlyne",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.outlyne.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.outlyne.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "outlyne",
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Outlyne saves your overlay cards to your photo library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
